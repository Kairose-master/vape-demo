{
  "version": 1,
  "organization": "synthetic-demo-org",
  "levels": ["L1", "L2", "L3"],
  "defaultEffect": "deny",
  "rules": [
    {"level":"L1","role":"operator","workflow":"local-only","operation":"read","destination":"file","effect":"allow"},
